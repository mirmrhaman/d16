# QA server environment template
# Copy to a local-only file (e.g., database/.env.qa.local) and set real values.
# Never commit real credentials.
# This is the only active runtime environment for now.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=dinterio_d16_qa
DB_USER=dinterio_d16_qa_app
DB_PASSWORD=replace_with_rotated_qa_password

# Encryption keys must be QA-only and different from production.
APP_ENCRYPTION_KEY_BASE64=replace_with_32_byte_base64_key
APP_HMAC_KEY_BASE64=replace_with_32_byte_base64_key

NODE_ENV=qa
TZ=UTC

# Optional: for local verification when cPanel DB host is localhost.
# These are used by database/check-qa-via-ssh-tunnel.sh.
QA_SSH_HOST=cpanel.example.com
QA_SSH_USER=cpanel_user
QA_SSH_PORT=22
QA_REMOTE_DB_HOST=localhost
QA_REMOTE_DB_PORT=3306
QA_LOCAL_FORWARD_PORT=13306
