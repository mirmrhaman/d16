# Server-side DB configuration (example)
# Do not commit real credentials.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Security
APP_ENCRYPTION_KEY_BASE64=replace_with_32_byte_base64_key
APP_HMAC_KEY_BASE64=replace_with_32_byte_base64_key

# Runtime
NODE_ENV=production
TZ=UTC
