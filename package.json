{
  "name": "gagrill-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "API_ENV_FILE=database/.env.qa.local NODE_ENV=qa node server/src/index.js",
    "dev:full": "node scripts/dev-full.js",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:database": "node scripts/test-local-database.js",
    "qa:bootstrap-admin": "API_ENV_FILE=database/.env.qa.local NODE_ENV=qa node scripts/bootstrap-admin.js",
    "qa:catalogue-preview": "API_ENV_FILE=database/.env.qa.local NODE_ENV=qa node scripts/seed-catalogue.js",
    "qa:catalogue-import": "API_ENV_FILE=database/.env.qa.local NODE_ENV=qa node scripts/seed-catalogue.js --apply",
    "build:qa": "VITE_DATA_MODE=database vite build",
    "build:demo": "VITE_DATA_MODE=demo vite build",
    "preview": "vite preview",
    "db:qa:check": "bash database/check-qa-connection.sh",
    "db:qa:verify": "bash database/check-qa-schema-seed.sh",
    "db:qa:prepare-macos": "bash database/setup-mysql-client-macos.sh --install",
    "db:qa:tunnel-check": "bash database/check-qa-via-ssh-tunnel.sh database/.env.qa.local check",
    "db:qa:tunnel-verify": "bash database/check-qa-via-ssh-tunnel.sh database/.env.qa.local verify"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.10",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "mysql2": "^3.14.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.20",
    "vite": "^6.3.5"
  }
}
