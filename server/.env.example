# API runtime
PORT=8787
NODE_ENV=qa

# Set this if you want dotenv to load a specific file.
# Example: database/.env.qa.local
API_ENV_FILE=database/.env.qa.local

# DB settings (fallback if API_ENV_FILE not used)
DB_HOST=127.0.0.1
